# ==========================================
# 🤖 JARVIS AI VOICE ASSISTANT CONFIGURATION
#       (Stark Industries macOS Edition)
# ==========================================

# Assistant & User Identity
ASSISTANT_NAME="Jarvis"
USER_NAME="Sir"

# Google Gemini API Key (Get free key from: https://aistudio.google.com)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# Text-to-Speech Engine:
#   'edge' -> Microsoft Edge Neural Voice (deep, realistic, studio-quality male voice)
#   'say'  -> macOS native voice (fast, 100% offline male voice)
TTS_ENGINE="edge"

# macOS Native Voice (Used when TTS_ENGINE="say" or as offline fallback)
MACOS_VOICE="Daniel"
MACOS_HINDI_VOICE="Rishi"
MACOS_HINGLISH_VOICE="Rishi"
MACOS_RATE="150"

# Edge TTS Neural Voice (Deep Male Voice Tuning)
EDGE_VOICE="en-GB-RyanNeural"
EDGE_HINDI_VOICE="hi-IN-MadhurNeural"
EDGE_PITCH="-8Hz"
EDGE_RATE="-2%"

# ==========================================
# 🛡️ WAKE WORD & BACKGROUND NOISE FILTER
# ==========================================
# When true, Jarvis blocks all background music, TV, and conversations.
# Jarvis ONLY activates when you say 'Hey Jarvis', 'Jarvis', or 'जार्विस'.
WAKE_WORD_REQUIRED="true"
WAKE_WORDS="jarvis,hey jarvis,hi jarvis,hello jarvis,oye jarvis,suno jarvis,arre jarvis,जार्विस"

# Speech Recognition Language ('en-IN' for Indian English + Hindi)
SPEECH_LANG="en-IN"

# Specific hardware microphone device index (Leave empty for auto-detecting MacBook Mic)
MIC_DEVICE_INDEX=""

# Microphone baseline energy threshold (recommended 100 - 250)
MIC_ENERGY_THRESHOLD="150"

# Audio chimes (plays subtle high-tech sound when mic activates)
AUDIO_CHIMES="true"

# ==========================================
# ⚡ UI & ANIMATIONS
# ==========================================
# Iron Man Arc Reactor boot sequence on terminal startup
SHOW_BOOT_ANIMATION="true"

# Default City for Weather Queries
DEFAULT_CITY="New Delhi"
